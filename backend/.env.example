# RayCarwash - Backend Configuration
# Copy this file to .env and fill in the values

# ──────────────────────────────────────────────
#  Application
# ──────────────────────────────────────────────
DEBUG=true
PROJECT_NAME=RayCarwash API
API_VERSION=v1
APP_BASE_URL=http://localhost:8000

# Selector for adapter binding. development | staging | production.
# In production the storage / email / sms adapters switch to S3 / SendGrid / Twilio.
RAYCARWASH_ENV=development

# ──────────────────────────────────────────────
#  Database (PostgreSQL with asyncpg)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/raycarwash
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ──────────────────────────────────────────────
#  Security / JWT
# ──────────────────────────────────────────────
# JWT_SECRET_KEY: Used ONLY for JWT signing (HS256).
#                 IMPORTANT: Do NOT use for encryption - see ENCRYPTION_KEY below.
#                 Generate: openssl rand -hex 32
JWT_SECRET_KEY=your-jwt-secret-key-here-generate-with-openssl-rand-hex-32

# ENCRYPTION_KEY: Used ONLY for PII encryption (full_name, phone_number).
#                IMPORTANT: Should be ROTATED INDEPENDENTLY from JWT_SECRET_KEY.
#                If you rotate JWT_SECRET_KEY, PII remains secure.
#                Generate: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-here-generate-with-openssl-rand-base64-32

# PHONE_LOOKUP_KEY: HMAC key for phone number hashing (for efficient lookup).
#                 Prevents rainbow table attacks on phone hashes.
#                 Generate: openssl rand -hex 32
PHONE_LOOKUP_KEY=your-phone-lookup-key-here-generate-with-openssl-rand-hex-32

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ──────────────────────────────────────────────
#  Stripe (use test keys for development)
# ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_CURRENCY=usd

# ──────────────────────────────────────────────
#  Rate Limiting
# ──────────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120

# ──────────────────────────────────────────────
#  Business Logic
# ──────────────────────────────────────────────
TRAVEL_BUFFER_MINUTES=30
CANCELLATION_FULL_REFUND_HOURS=24
CANCELLATION_PARTIAL_REFUND_HOURS=2
CANCELLATION_PARTIAL_REFUND_PERCENT=50

# ──────────────────────────────────────────────
#  Email (SMTP)
# ──────────────────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@raycarwash.com
SMTP_FROM_NAME=RayCarwash

# ──────────────────────────────────────────────
#  OAuth (optional for development)
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=com.raycarwash.app

# ──────────────────────────────────────────────
#  CORS
# ──────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# ──────────────────────────────────────────────
#  Profile system (Phase 0)
# ──────────────────────────────────────────────
# Step-up auth (ADR-004). Window during which a recent auth event satisfies
# require_step_up. Redis is the primary store; users.last_step_up_at is the
# fallback if Redis is unavailable.
STEP_UP_TTL_MINUTES=5

# ──────────────────────────────────────────────
#  File storage (ADR-008)
# ──────────────────────────────────────────────
# Development: LocalStorageAdapter writes here. Each logical bucket
# (public-assets, private-docs) becomes a subdirectory.
STORAGE_LOCAL_PATH=./storage

# HMAC key used to sign LocalStorageAdapter's "presigned" upload URLs.
# /dev/upload validates this before writing the file. Production unused.
# Generate: openssl rand -hex 32
DEV_UPLOAD_HMAC_KEY=dev-upload-hmac-CHANGE-ME

# TODO(prod): AWS S3 + CloudFront for production. Uncomment and set:
# AWS_S3_BUCKET_PUBLIC=raycarwash-public-assets
# AWS_S3_BUCKET_PRIVATE=raycarwash-private-docs
# AWS_REGION=us-east-2
# AWS_KMS_KEY_ID=
# CLOUDFRONT_DOMAIN=d111.cloudfront.net

# ──────────────────────────────────────────────
#  Workers / queue
# ──────────────────────────────────────────────
# RQ uses the REDIS_URL above. No extra config needed for dev. Start with:
#   docker compose --profile workers up -d rq-worker rq-scheduler
# Or locally: rq worker default low high

# ──────────────────────────────────────────────
#  Dev email + SMS sinks
# ──────────────────────────────────────────────
# Email is captured by MailHog (see docker-compose.yml). Override SMTP_HOST
# above to "localhost" and SMTP_PORT to 1025 to point to MailHog.
# UI: http://localhost:8025
#
# SMS in dev is logged to stdout. Set SMS_PROVIDER=twilio to enable real
# delivery (and provide TWILIO_* credentials when those services come online
# in Phase 3).
SMS_PROVIDER=console
# TODO(phase3): TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER

# ──────────────────────────────────────────────
#  Geocoding (Phase 4)
# ──────────────────────────────────────────────
GEOCODING_PROVIDER=nominatim
# TODO(prod): GOOGLE_MAPS_API_KEY

# ──────────────────────────────────────────────
#  IP geolocation (Phase 3 — populates user_login_history.ip_location)
# ──────────────────────────────────────────────
IP_GEOLOCATION_PROVIDER=null
# TODO(prod): MAXMIND_LICENSE_KEY or IPAPI_KEY
