NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_APPSTORE_URL=https://apps.apple.com/
NEXT_PUBLIC_PLAYSTORE_URL=https://play.google.com/
NEXT_PUBLIC_CONTACT_EMAIL=hello@raycarwash.com

# Optional — paste your Google OAuth Web Client ID (Cloud Console > Credentials).
# Without this, the "Continue with Google" button is hidden.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Required for the booking flow — Stripe publishable key (pk_test_... or pk_live_...).
# Without this, the booking summary will not be able to collect payment.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
